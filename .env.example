# OutWear Backend Environment Configuration Template
# Copy this file to .env in /server (or root) and fill in your actual credentials.

# Application Environment (development, production, or test)
NODE_ENV=development

# Backend Server Port (default is 4000)
PORT=4000

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma pooled connection, e.g. Supabase port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct PostgreSQL Connection URL (for Prisma migrations, e.g. Supabase port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JSON Web Token Secret (MUST be at least 32 characters long for cryptographic security)
JWT_SECRET=your_super_secret_jwt_key_with_at_least_32_characters

# Cloudinary Configuration for Wardrobe Photo Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
